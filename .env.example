# GoCreate OS v6.2 — same repository for Windows core and Vercel
GOCREATE_DEPLOYMENT_MODE=cloud
FIREBASE_PROJECT_ID=jollytiles
FIREBASE_DATABASE_URL=https://jollytiles-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=jollytiles.appspot.com
# Vercel: set ONE of these secrets. Never commit the value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Windows core may use a file instead:
GOOGLE_APPLICATION_CREDENTIALS=C:\GoCreate\secrets\jollytiles-service-account.json
GOCREATE_SESSION_SECRET=
NEXT_PUBLIC_GOCREATE_API_URL=
NEXT_PUBLIC_KIOSK_ID=front-door
NEXT_PUBLIC_KIOSK_LABEL=Front Desk
SUPER_ADMIN_EMAILS=
